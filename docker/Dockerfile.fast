# Build acelerado para iteração local: reusa index.bin já gerado fora do Docker.
# NÃO usar para submissão à Rinha — esse Dockerfile depende do contexto local.
# ── Stage 1: builder ──────────────────────────────────────────────────────────
FROM rust:1.95-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y musl-tools && rm -rf /var/lib/apt/lists/*
RUN rustup target add x86_64-unknown-linux-musl

COPY Cargo.toml Cargo.lock* ./
COPY .cargo .cargo
RUN mkdir -p src/bin && \
    echo 'fn main() {}' > src/main.rs && \
    echo 'fn main() {}' > src/bin/build_index.rs && \
    cargo build --release --target x86_64-unknown-linux-musl 2>/dev/null || true

COPY src ./src
RUN touch src/main.rs src/bin/build_index.rs && \
    cargo build --release --target x86_64-unknown-linux-musl --bin fraud-api

# ── Stage 2: utilitário healthcheck ──────────────────────────────────────────
FROM busybox:1.36-musl AS healthcheck-tools

# ── Stage 3: runtime scratch ──────────────────────────────────────────────────
FROM scratch

WORKDIR /app

COPY --from=builder /app/target/x86_64-unknown-linux-musl/release/fraud-api ./
COPY index.bin ./
COPY resources/mcc_risk.json ./resources/
COPY --from=healthcheck-tools /bin/busybox /bin/busybox

EXPOSE 9998

CMD ["./fraud-api"]
