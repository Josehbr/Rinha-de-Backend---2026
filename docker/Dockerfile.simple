# ── Stage 1: builder ──────────────────────────────────────────────────────────
FROM rust:1.95-slim AS builder

WORKDIR /app

# Instala musl-tools para binário estático
RUN apt-get update && apt-get install -y musl-tools && rm -rf /var/lib/apt/lists/*

RUN rustup target add x86_64-unknown-linux-musl

# Copia manifesto primeiro para cachear dependências
COPY Cargo.toml Cargo.lock* ./
COPY .cargo .cargo

# Cria src dummy para cachear deps
RUN mkdir -p src/bin && \
    echo 'fn main() {}' > src/main.rs && \
    echo 'fn main() {}' > src/bin/build_index.rs && \
    cargo build --release --target x86_64-unknown-linux-musl 2>/dev/null || true

# Copia código real
COPY src ./src

# Força rebuild dos binários reais
RUN touch src/main.rs src/bin/build_index.rs && \
    cargo build --release --target x86_64-unknown-linux-musl --bin fraud-api --bin fraud-lb --bin build-index

# ── Stage 2: builder do índice ────────────────────────────────────────────────
FROM debian:bookworm-slim AS index-builder

WORKDIR /app

COPY --from=builder /app/target/x86_64-unknown-linux-musl/release/build-index ./
COPY resources/ ./resources/

# Gera o índice IVF pré-computado em tempo de build
RUN ./build-index

# ── Stage 3: utilitário mínimo para healthcheck ───────────────────────────────
FROM busybox:1.36-musl AS healthcheck-tools

# ── Stage 3: runtime mínimo ───────────────────────────────────────────────────
FROM scratch

WORKDIR /app

COPY --from=builder /app/target/x86_64-unknown-linux-musl/release/fraud-api ./
COPY --from=builder /app/target/x86_64-unknown-linux-musl/release/fraud-lb ./
COPY --from=index-builder /app/index.bin ./
COPY resources/mcc_risk.json ./resources/
COPY --from=healthcheck-tools /bin/busybox /bin/busybox

EXPOSE 9998

CMD ["./fraud-api"]
